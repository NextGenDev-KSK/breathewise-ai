# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Get a key at https://aistudio.google.com/apikey . Leave empty to run in rule-based mode.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite (stable, low-latency Flash-Lite model, verified 2026-11-18).
GEMINI_MODEL=
# Optional. Free key from https://explore.openaq.org (account settings). Enables nearest monitoring-station
# readings (CPCB and state boards in India) and a National AQI calculated with the CPCB method.
OPENAQ_API_KEY=
